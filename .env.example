# ---- Database ----
# Inside docker-compose the host is "postgres"; for local dev use localhost.
DATABASE_URL=postgres://loopy:loopy@localhost:5432/loopyfriday

# ---- Auth ----
# Generate a long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL the app is reached at (used for auth + invite links).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Storage ----
# Root directory for uploaded + processed files (audio, peaks, scores).
DATA_DIR=./data/files
# Max size for a single recording upload, in bytes (default 2 GiB).
UPLOAD_MAX_BYTES=2147483648
# Storage backend: "local" (default) or "s3" (currently a stub).
STORAGE_DRIVER=local
# S3/MinIO settings (only used when STORAGE_DRIVER=s3):
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Initial admin (used by `npm run seed`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Admin
